# Notion API
# Get from: https://www.notion.com/my-integrations → Create new integration
NOTION_API_KEY=ntn_xxxxxxxxxxxxx

# LinkedIn API — optional, needed for automated metric sync
# Get from: https://www.linkedin.com/developers/apps
# Required scope: r_organization_social (Marketing Developer Platform)
LINKEDIN_API_TOKEN=your_linkedin_api_token_here

# LinkedIn Org ID — numeric ID from your company admin URL
# e.g. linkedin.com/company/110589471/admin/ → 110589471
LINKEDIN_ORG_ID=110589471

# --- Not wired up yet — see tracker/x_tracker.py and tracker/reddit_tracker.py stubs ---
# X_API_BEARER_TOKEN=
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
