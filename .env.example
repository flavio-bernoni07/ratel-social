# Notion API
# Get from: https://www.notion.com/my-integrations → Create new integration
NOTION_API_KEY=ntn_xxxxxxxxxxxxx

# LinkedIn API — optional, needed for automated metric sync
# Get from: https://www.linkedin.com/developers/apps
# Required scope: r_organization_social (Marketing Developer Platform)
LINKEDIN_API_TOKEN=your_linkedin_api_token_here

# LinkedIn Org ID — numeric ID from your company admin URL
# e.g. linkedin.com/company/110589471/admin/ → 110589471
LINKEDIN_ORG_ID=110589471

# X API — optional, needed for X metric sync
# Get from: https://developer.x.com → create an app → needs a tier with tweet public_metrics
X_API_BEARER_TOKEN=your_x_bearer_token_here

# Reddit API — optional, needed for Reddit metric sync
# Get from: https://www.reddit.com/prefs/apps → create a "script" app
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=ratel-social-tracker/1.0 by u/yourusername

# HeyGen — optional, used by /video for higher-quality voiceover + music retrieval.
# Without it, /video falls back to local Kokoro TTS (works offline, one voice family, no music
# retrieval). Get from: https://developers.heygen.com/cli, then `heygen auth login --oauth`
# (this stores a credential in ~/.heygen/credentials — HEYGEN_API_KEY here is only needed if you
# want to skip that login flow and use a raw API key instead).
HEYGEN_API_KEY=your_heygen_api_key_here

# Gemini/Google API — optional, used by /video's music agent for local music generation (Lyria)
# when there's no HeyGen credential. Without this, local generation falls back further to
# MusicGen, which is slower and lower quality. Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
